{
  "name": "my_site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.3.6",
    "next-mdx-remote": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "overrides": {
      "eslint": "9.39.4",
      "@babel/core": "7.29.6",
      "@humanfs/node": "0.16.8",
      "browserslist": "4.28.7",
      "esbuild": "0.28.1",
      "undici": "7.29.0",
      "vite": "7.3.5",
      "yaml": "2.8.3",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
